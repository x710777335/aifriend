# Leave USE_MOCK_LLM=true to run without a service or API key.
USE_MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
CONTEXT_TURNS=8
# Voice options can live in config.toml; see config.example.toml.

# ESP32 server. Keep this value secret; it is sent by the device as Bearer auth.
FRIEND_DEVICE_TOKEN=
